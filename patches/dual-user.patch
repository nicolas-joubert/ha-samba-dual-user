@@ -54,6 +54,8 @@ schema:
   username: str
   password: password
   workgroup: str
+  ro_username: str?
+  ro_password: password?
   enabled_shares:
     - "match(^(?i:(local_apps|app_configs|addons|addon_configs|backup|config|media|share|ssl))$)"
   compatibility_mode: bool
diff --git a/samba_dual_user/rootfs/etc/s6-overlay/s6-rc.d/init-smbd/run b/samba_dual_user/rootfs/etc/s6-overlay/s6-rc.d/init-smbd/run
index a7918f7..d2ebcca 100755
--- a/samba_dual_user/rootfs/etc/s6-overlay/s6-rc.d/init-smbd/run
+++ b/samba_dual_user/rootfs/etc/s6-overlay/s6-rc.d/init-smbd/run
@@ -8,6 +8,8 @@ declare password
 declare username
 declare config_username
 declare samba_username
+declare ro_username
+declare ro_password
 declare stored_options
 declare migration_payload
 declare -a interfaces=()
@@ -79,11 +81,18 @@ if [[ "${config_username}" =~ [[:space:]] ]]; then
     } >/etc/samba/smbusers
 fi
 
+ro_username=""
+if bashio::config.has_value 'ro_username'; then
+    ro_username=$(bashio::config 'ro_username' | tr '[:space:]' '_')
+fi
+
 jq --arg username "${samba_username}" \
+    --arg ro_username "${ro_username}" \
     --argjson interfaces "$(jq -c -n '$ARGS.positional' --args -- "${interfaces[@]}")" \
     '.interfaces = $interfaces |
     .enabled_shares.[] |= ascii_downcase |
-    .username = $username' /data/options.json \
+    .username = $username |
+    .ro_username = $ro_username' /data/options.json \
     | tempio \
       -template /usr/share/tempio/smb.gtpl \
       -out /etc/samba/smb.conf
@@ -96,3 +105,12 @@ adduser -D -H -G "${username}" -s /bin/false "${username}"
 
 printf '%s\n%s\n' "${password}" "${password}" \
     | smbpasswd -a -s -c "/etc/samba/smb.conf" "${username}"
+
+# Init read-only user (optional second account, forced read-only on every share)
+if [[ -n "${ro_username}" ]] && bashio::config.has_value 'ro_password'; then
+    ro_password=$(bashio::config 'ro_password')
+    addgroup "${ro_username}"
+    adduser -D -H -G "${ro_username}" -s /bin/false "${ro_username}"
+    printf '%s\n%s\n' "${ro_password}" "${ro_password}" \
+        | smbpasswd -a -s -c "/etc/samba/smb.conf" "${ro_username}"
+fi
